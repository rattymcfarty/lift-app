{
  "expo": {
    "android": {
      "package": "app.lift.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#111827"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "app.lift.mobile",
      "supportsTablet": true
    },
    "name": "LIFT",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "./plugins/withAndroidBackupRules",
      "./plugins/withIosBackupExclusion",
      "expo-notifications",
      "./plugins/withAndroidReleaseSigning"
    ],
    "scheme": "liftapp",
    "slug": "lift-app",
    "userInterfaceStyle": "automatic",
    "version": "0.1.0",
    "icon": "./assets/brand/icon.png"
  }
}
